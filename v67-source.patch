+impl CpuWriteGpuReadBuffer<u8> {
+    /// Expands tightly packed RGB8 rows directly into this mapped RGBA8 upload
+    /// buffer. This deliberately avoids allocating an intermediate Vec.
+    pub fn extend_rgb8_as_rgba(
+        &mut self,
+        rgb: &[u8],
+        width: usize,
+        height: usize,
+        padded_row_bytes: usize,
+    ) -> Result<(), CpuWriteGpuReadError> {
+        let source_row_bytes = width.checked_mul(3).unwrap_or(usize::MAX);
+        let required = padded_row_bytes.saturating_mul(height);
+        if width == 0
+            || height == 0
+            || rgb.len() != source_row_bytes.saturating_mul(height)
+            || padded_row_bytes < width.saturating_mul(4)
+            || required > self.remaining_capacity()
+        {
+            return Err(CpuWriteGpuReadError::BufferFull {
+                buffer_capacity_elements: self.capacity(),
+                num_elements_attempted_to_add: padded_row_bytes.saturating_mul(height),
+                num_elements_actually_added: self.remaining_capacity(),
+            });
+        }
+        for row in 0..height {
+            let source = &rgb[row * source_row_bytes..(row + 1) * source_row_bytes];
+            let destination = &mut self.as_mut_byte_slice()[..padded_row_bytes];
+            for (rgb, rgba) in source
+                .chunks_exact(3)
+                .zip(destination[..width * 4].chunks_exact_mut(4))
+            {
+                rgba[..3].copy_from_slice(rgb);
+                rgba[3] = u8::MAX;
+            }
+            destination[width * 4..].fill(0);
+            self.unwritten_element_range.start += padded_row_bytes;
+        }
         Ok(())
     }
 }
