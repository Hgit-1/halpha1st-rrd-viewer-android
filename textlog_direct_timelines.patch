+    /// Returns compact timeline values for rows that contain the specified component.
+    ///
+    /// This avoids creating a temporary `TimePoint`/`BTreeMap` for every row. The compact slice
+    /// can be shared by all component values in the same source row.
+    pub fn iter_component_timeline_values(
+        &self,
+        component_name: &ComponentName,
+    ) -> Box<dyn Iterator<Item = Arc<[(Timeline, TimeInt)]>> + '_> {
+        let Some(list_array) = self.components.get(component_name) else {
+            return Box::new(std::iter::empty());
+        };
+
+        let mut timelines = self
+            .timelines
+            .values()
+            .map(|time_column| (time_column.timeline, time_column.times()))
+            .collect_vec();
+
+        let row_count = list_array.len();
+        let validity = list_array.validity().cloned();
+        let mut row_index = 0;
+        Box::new(std::iter::from_fn(move || {
+            while row_index < row_count {
+                let mut values = Vec::with_capacity(timelines.len());
+                for (timeline, times) in &mut timelines {
+                    // Every time column has one value per row, including static chunks.
+                    // A malformed chunk is treated as exhausted rather than panicking here.
+                    values.push((*timeline, times.next()?));
+                }
+                let valid = validity
+                    .as_ref()
+                    .is_none_or(|validity| validity.get_bit(row_index));
+                row_index += 1;
+                if valid {
+                    return Some(Arc::from(values.into_boxed_slice()));
+                }
+            }
+            None
+        }))
     }
 
